# 공사 OpenAPI (EI-KT)
# ⚠️ 실제 인증키는 .env 에만 두고 절대 커밋하지 않는다 (PM-SC-001 · 003)
KTO_SERVICE_KEY=

# 개발·테스트에서 fixtures/kto 스냅샷을 리플레이한다. 호출 예산을 쓰지 않는다.
#   운영(NODE_ENV=production)에서는 기동이 거부된다 — 모의 응답 전면 대체는 심사 제외 사유다 (FR-OP-009)
# KTO_MODE=fixture
# KTO_FIXTURE_DIR=fixtures/kto

# 응답 타임아웃 ms (EI-CM-004, 기본 10000)
# KTO_TIMEOUT_MS=10000
# KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 외부 호출 타임아웃 (EI-CM-004). 연결과 응답을 나눠 건다
HTTP_CONNECT_TIMEOUT_MS=3000
HTTP_RESPONSE_TIMEOUT_MS=10000

# 기상청 단기·중기예보 (EI-WX) — R09 우천 리스크
# data.go.kr 계정 단위 인증키라 KTO_SERVICE_KEY 와 값이 같다.
# 인증은 계정 하나, 인가는 서비스별 활용신청이라 신청은 따로 해야 한다
KMA_SERVICE_KEY=
# 개발·테스트에서 fixtures/kma 스냅샷을 리플레이한다. 운영에서는 기동이 거부된다
# 스냅샷은 2026.08.26 강릉 격자·강원영동 고정이라 예보 날짜도 그때 그대로다
# KMA_MODE=fixture
# KMA_FIXTURE_DIR=fixtures/kma

# 카카오모빌리티 길찾기 (EI-KM) — R08 이동시간
KAKAO_REST_API_KEY=
# 개발·테스트에서 fixtures/kakao 스냅샷을 리플레이한다. 운영에서는 기동이 거부된다
# KAKAO_MODE=fixture
# KAKAO_FIXTURE_DIR=fixtures/kakao

# LLM (EI-LM) — F01 자연어 일정 구조화 · F03 파서 폴백
#
# ⚠️ 모델은 `temperature` 를 받는 것이어야 한다. EI-LM-002(M) 가 temperature 0 을 요구하는데
#    이 값을 거부하는 모델이 있고, 그러면 그 용도가 통째로 HTTP 400 으로 죽는다 (이슈 #371).
#    어댑터는 오류 본문을 읽지 않으므로(원문 되돌아옴 방지) 400 만 보이고 사유가 안 보인다.
#
#    2026.09.10 실측
#      claude-sonnet-4-6            temperature=0  200
#      claude-haiku-4-5-20251001    temperature=0  200
#      claude-sonnet-5 · opus-5     temperature=0  400  `temperature` is deprecated
LLM_PROVIDER=
LLM_MODEL_STRUCTURE=
LLM_MODEL_NORMALIZE=
LLM_API_KEY=

# DB
DATABASE_URL=

# 저장소 통합 테스트용. 비어 있으면 DB 테스트를 건너뛴다 (db/README.md 참조)
# TEST_DATABASE_URL=postgres://postgres:test@localhost:55432/tourlint_test

# 배치 (F12)
# 감시 대상 상품 수 상한 (FR-MO-020). 기본 10건이며 개발 기간 중 운영 가드다.
# 설정 화면 항목이 아니다 — FR-OP-021 이 설정을 10종으로, FR-OP-024 가 전역 값을 2종으로
# 못박아 두었다. 상한에 걸리면 출발일이 먼 상품부터 잘린다.
# BATCH_WATCH_LIMIT=10
